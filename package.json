{
  "name": "proyecto-cli",
  "type": "module",
  "version": "2.5.7",
  "description": "Proyecto is a lightweight CLI tool for managing local projects",
  "author": {
    "name": "Robert Wang",
    "email": "glorywong1001@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/robertwang1001/proyecto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertwang1001/proyecto.git"
  },
  "bugs": {
    "url": "https://github.com/robertwang1001/proyecto/issues"
  },
  "keywords": [
    "project",
    "cli",
    "command line interface",
    "pro",
    "manage",
    "create",
    "clone",
    "git",
    "github"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bin": {
    "proyecto": "./cli.ts"
  },
  "scripts": {
    "cli": "NODE_ENV=development bun cli.ts",
    "compile": "bun build --compile --minify --asset-naming='[name].[ext]' --outfile=dist/proyecto cli.ts",
    "prepare": "bun simple-git-hooks",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "coverage": "bun test --coverage"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/input": "^5.1.2",
    "@inquirer/search": "^4.2.1",
    "chalk": "^5.6.2",
    "conf": "^15.1.0",
    "env-paths": "^4.0.0",
    "fs-extra": "^11.4.0",
    "fuzzysort": "^3.1.0",
    "iso-timestamp": "^1.2.0",
    "minimist": "^1.2.8",
    "open-editor": "^6.0.0",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "1.3.14",
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "24.13.3",
    "eslint": "^10.8.0",
    "lint-staged": "^17.2.0",
    "simple-git-hooks": "^2.13.1",
    "type-fest": "^5.8.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged",
    "commit-msg": "bun commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "bun lint:fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
